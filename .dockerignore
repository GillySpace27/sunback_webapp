# Keep the image to exactly what the app needs: requirements + vendor wheel
# + api/ tree. Everything else is dev-machine or legacy clutter.
.git
.gitignore
.claude
.env
.sunpy
__pycache__
**/__pycache__
api/__pycache__
feedback.json
launch_readiness.json
SESSION_NOTES.md
TODOS.md
pipeline.py
run_server
render.yaml
fly.toml
Dockerfile
.dockerignore
infra/
MIGRATION.md
default_cache/
# Dev-only render output + legacy backups — never COPY'd into the image, but
# they were still uploaded in the build context (~2 GB) on every deploy.
solar_archive_output/
dep/
# render-service also builds from this root context (needs web3d/ as a
# sibling); these are local dev/scratch output, never wanted in either image.
web3d/node_modules
web3d/dist
web3d/captures*
web3d/plates*
web3d/timelapse
web3d/rainbow
web3d/*.png
web3d/tsconfig.tsbuildinfo
render-service/node_modules
