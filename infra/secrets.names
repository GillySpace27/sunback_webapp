# Secret NAMES only, per app (MH-6). Never a value, never a digest.
# drift.sh compares each list with `fly secrets list` / `wrangler secret list`; a name on one side
# only is DRIFT. Format: <app> <SECRET_NAME>, one pair per line; "<app> -" means no secrets expected.
# Sources, read 2026-10-01: fly.toml header comment (checked against `fly secrets list` on
# 2026-08-22), fly.dev.toml header comment, infra/worker/wrangler.jsonc header comment.
# Dev has no SHOPIFY_* names on purpose (Gilly, 2026-08-22): drift.sh flags any as DRIFT.
myheliograph-api FEEDBACK_ADMIN_KEY
myheliograph-api ALLOWED_ORIGINS
myheliograph-api PRINTIFY_API_KEY
myheliograph-api PRINTIFY_SHOP_ID
myheliograph-api SOLAR_ARCHIVE_JSOC_EMAIL
myheliograph-api SHOPIFY_STORE_DOMAIN
myheliograph-api SHOPIFY_STOREFRONT_ACCESS_TOKEN
myheliograph-api SHOPIFY_ADMIN_CLIENT_ID
myheliograph-api SHOPIFY_ADMIN_CLIENT_SECRET
myheliograph-api-dev FEEDBACK_ADMIN_KEY
myheliograph-api-dev INTERNAL_AUTH_TOKEN
myheliograph-api-dev ALLOWED_ORIGINS
myheliograph-api-dev PRINTIFY_API_KEY
myheliograph-api-dev PRINTIFY_SHOP_ID
myheliograph-api-dev SOLAR_ARCHIVE_JSOC_EMAIL
myheliograph-render -
myheliograph-router ADMIN_KEY
myheliograph-router-dev -
